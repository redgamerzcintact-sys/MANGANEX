# ==============================================================================
# MANGANEX — THE EARTH'S HIDDEN INTELLIGENCE
# Enterprise Geological Exploration & Mining Platform Environment Configuration
# ==============================================================================

# ── 1. Core Server & Runtime ──────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_DEMO_AUTH_TOKENS=false
FRONTEND_PORT=3000
PYTHON_BACKEND_HOST=127.0.0.1
PYTHON_BACKEND_PORT=8000
JAVA_BACKEND_PORT=8080

# Frontend & CORS (set VITE_API_BASE_URL to your proxied / Cloudflare Tunnel API URL in prod)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
BACKEND_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.pages\.dev$

# Java Enterprise Backend Security
MANGANEX_JWT_SECRET=replace-with-a-different-long-random-secret
MANGANEX_JWT_EXPIRATION_MS=86400000
MANGANEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional Demo Account Passwords (leave unset to disable predictable demo credentials)
MANGANEX_DEMO_ADMIN_PASSWORD=
MANGANEX_DEMO_GEOLOGIST_PASSWORD=
MANGANEX_DEMO_ENGINEER_PASSWORD=
MANGANEX_DEMO_ANALYST_PASSWORD=
MANGANEX_DEMO_VIEWER_PASSWORD=
# ── 2. Database Persistence (PostgreSQL + PostGIS + pgvector) ─────────────────
# For production PostgreSQL: postgresql://manganex_user:password@localhost:5432/manganex_db
# For lightweight embedded SQLite: sqlite:///./manganex.db
DATABASE_URL=sqlite:///./manganex.db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── 3. AI / LLM & RAG Vector Engine (Hugging Face & Sentence Transformers) ────
# Get your Hugging Face Access Token from: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=fallback
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ── 4. Remote Sensing & Satellite Data Providers ──────────────────────────────
# Copernicus Data Space Ecosystem (Sentinel-2 Level-2A): https://dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# NASA Earthdata (ASTER GDEM & Surface Temperature): https://urs.earthdata.nasa.gov
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=

# USGS EarthExplorer (Landsat-9 OLI): https://ers.cr.usgs.gov
USGS_M2M_USERNAME=
USGS_M2M_PASSWORD=
USGS_M2M_API_KEY=

# ── 6. Geospatial Mapping & GIS Providers ─────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── 6. Speech Recognition & Voice Synthesis ───────────────────────────────────
# Browser Web Speech API is used by default. Server-side Whisper (optional):
WHISPER_API_URL=
WHISPER_API_KEY=
TTS_PROVIDER=browser

