# MANGANEX Python AI/ML & Remote Sensing Service Configuration
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_DEMO_AUTH_TOKENS=true
PYTHON_BACKEND_HOST=127.0.0.1
PYTHON_BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
BACKEND_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.pages\.dev$

# Database
DATABASE_URL=sqlite:///./manganex.db

# Hugging Face & RAG Engine
HF_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=fallback
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Satellite APIs
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
NASA_EARTHDATA_TOKEN=

# Optional demo account passwords (leave unset to disable known demo credentials)
MANGANEX_DEMO_ADMIN_PASSWORD=
MANGANEX_DEMO_GEOLOGIST_PASSWORD=
MANGANEX_DEMO_ENGINEER_PASSWORD=
MANGANEX_DEMO_ANALYST_PASSWORD=
MANGANEX_DEMO_VIEWER_PASSWORD=

# Google Maps GIS Key (set only in ignored backend/.env — NEVER commit)
GOOGLE_MAPS_API_KEY=
